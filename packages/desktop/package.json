{
  "name": "@decision-forge/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --outfile=dist/main/index.js --external:electron --external:better-sqlite3 --external:keytar && esbuild src/main/preload.ts --bundle --platform=node --outfile=dist/main/preload.js --external:electron",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "dev": "rm -rf dist/renderer && pnpm build:main && concurrently \"vite\" \"wait-on http://localhost:5273 && VITE_DEV_SERVER_URL=http://localhost:5273 electron .\"",
    "electron": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@decision-forge/core": "workspace:*",
    "dagre": "^0.8.5",
    "keytar": "^7.9.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-force-graph-3d": "^1.29.1",
    "react-router-dom": "^6.28.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "esbuild": "^0.24.2",
    "framer-motion": "^11.11.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0"
  }
}
